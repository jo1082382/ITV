<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".ItvApplication"
        android:allowBackup="true"
        android:label="@string/itv_launcher_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".presentation.permissions.PermissionSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.usage.UsageReportActivity"
            android:exported="false" />

        <activity android:name=".presentation.character.CompanionPreviewActivity" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카카오 로그인 Redirect 수신 액티비티 -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="oauth" android:scheme="kakao${kakaoAppKey}" />
            </intent-filter>
        </activity>

        <activity android:name=".presentation.coaching.CoachingTestActivity" android:exported="false" />
        <activity android:name=".presentation.jev.JevTestActivity" android:exported="false" />
        <service
            android:name=".presentation.coaching.CoachingMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started digital wellbeing test: measure screen-interactive unlocked duration and show a puppy break overlay after 60 seconds; user can stop via persistent notification." />
        </service>

        <service
            android:name=".presentation.coaching.WritingGuardService"
            android:label="@string/itv_writing_guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/itv_writing_guard" />
        </service>

        <activity
            android:name=".presentation.coaching.ReelsProbeActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.coaching.YoutubeProbeActivity"
            android:exported="false" />
        <activity android:name=".presentation.usage.AiHistoryActivity" android:exported="false" />

        <!-- 수면 ASMR 알림창 제어 리시버 (앱 진입 없이 알림창에서 즉시 끄기) -->
        <receiver
            android:name=".infrastructure.sleep.AsmrStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.itv.ACTION_STOP_ASMR" />
            </intent-filter>
        </receiver>

        <!-- 수면 화면 모드 알림창 제어 리시버 (앱 진입 없이 알림창에서 즉시 색상 복원) -->
        <receiver
            android:name=".infrastructure.sleep.GrayscaleStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.itv.ACTION_STOP_GRAYSCALE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
