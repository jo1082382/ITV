rules_version = '2';

// =============================================================================
// Assumed Data Model (Cloud Firestore Standard Edition - `(default)` database)
// =============================================================================
// 1. `users/{userId}` & subcollections (`profile/state`, `monthly_archives/{ym}`,
//    `shortform_sessions/{ym}`, `shortform_daily/{ym}`):
//    Strict per-user cloud backup for social-authenticated accounts.
// 2. `support_admins/{adminUid}`:
//    Server/Console-managed admin ACL. Each social user may only `get` their own
//    document to verify admin UI visibility. All client writes are denied.
// 3. `support_inquiries/{inquiryId}`:
//    Customer Center 1:1 inquiries.
//    - uid: string (1..128, immutable, == request.auth.uid)
//    - authorProvider: 'GOOGLE'|'KAKAO'|'NAVER'|'GUEST' (immutable)
//    - authorLabel: string (1..60, non-PII display label, immutable)
//    - category: 'BUG'|'SUGGESTION'|'USAGE_PERMISSION'|'ACCOUNT_DATA'|'OTHER' (immutable)
//    - title: string (2..80, immutable)
//    - content: string (5..1000, immutable)
//    - diagnostics: map|null (strictly typed 7 fields, immutable)
//    - status: 'RECEIVED'|'ANSWERED' ('RECEIVED' on create; admin transitions to 'ANSWERED')
//    - adminReply: string(1..2000)|null (null on create; admin sets on answer)
//    - adminUid: string(1..128)|null (null on create; == admin request.auth.uid on answer)
//    - createdAt: int epoch ms (immutable)
//    - repliedAt: int epoch ms|null (null on create; admin sets on answer)
//    - updatedAt: int epoch ms (>= createdAt, monotonic on update)
//    - isReplyRead: bool (true on create; false when admin answers; owner may set true)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny everything unless explicitly matched and validated below.
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Authentication & Authorization Helpers
    // -------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.uid.size() > 0
        && request.auth.uid.size() <= 128;
    }

    // Guest (anonymous) sessions stay strictly on-device until linked to Google/Kakao/Naver.
    function isSocialUser() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isSocialUser() && request.auth.uid == userId;
    }

    // Verified support admin: Firebase Auth custom claim (`admin == true`) OR
    // server/console-managed `support_admins/{uid}` document (never client-writable).
    function isSupportAdmin() {
      return isSocialUser() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/support_admins/$(request.auth.uid))
      );
    }

    function isValidInquiryId(inquiryId) {
      return inquiryId is string && inquiryId.matches('^[a-zA-Z0-9_-]{8,64}$');
    }

    function isValidEpochMs(val) {
      return val is int && val >= 1577836800000 && val <= 4102444800000;
    }

    function isValidOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidOptionalInt(val, minVal, maxVal) {
      return val == null || (val is int && val >= minVal && val <= maxVal);
    }

    function isValidYearMonthId(ym) {
      return ym is string && ym.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // -------------------------------------------------------------------------
    // Domain Schema Validators (called on BOTH create AND update)
    // -------------------------------------------------------------------------
    function isValidUserRoot(data) {
      return data.keys().hasOnly([
          'provider',
          'displayName',
          'email',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'lastBackupAt'
        ])
        && data.keys().hasAll([
          'provider',
          'displayName',
          'email',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'lastBackupAt'
        ])
        && data.provider is string
        && data.provider in ['GOOGLE', 'KAKAO', 'NAVER']
        && isValidOptionalString(data.displayName, 100)
        && isValidOptionalString(data.email, 254)
        && data.schemaVersion is int
        && data.schemaVersion >= 1 && data.schemaVersion <= 10
        && isValidEpochMs(data.createdAt)
        && isValidEpochMs(data.updatedAt)
        && isValidEpochMs(data.lastBackupAt);
    }

    function isValidProfileState(data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'updatedAt',
          'rewardTotalExp',
          'rewardPoints',
          'rewardTotalMissions',
          'equippedSlotsJson',
          'stampedDatesJson',
          'selectedCharacterId',
          'darkMode',
          'coachingInterventionType',
          'coachingIntensity',
          'characterIntensity',
          'coachingTone',
          'bedtimeCareEnabled',
          'customBedtimeHour',
          'customBedtimeMinute',
          'goalsJson',
          'sleepConfirmationsJson',
          'bedtimeMemoContent',
          'bedtimeMemoSavedAt',
          'bedtimeMemoPending'
        ])
        && data.keys().hasAll([
          'schemaVersion',
          'updatedAt',
          'rewardTotalExp',
          'rewardPoints',
          'rewardTotalMissions',
          'equippedSlotsJson',
          'stampedDatesJson',
          'selectedCharacterId',
          'darkMode',
          'coachingInterventionType',
          'coachingIntensity',
          'characterIntensity',
          'coachingTone',
          'bedtimeCareEnabled',
          'customBedtimeHour',
          'customBedtimeMinute',
          'goalsJson',
          'sleepConfirmationsJson',
          'bedtimeMemoContent',
          'bedtimeMemoSavedAt',
          'bedtimeMemoPending'
        ])
        && data.schemaVersion is int
        && data.schemaVersion >= 1 && data.schemaVersion <= 10
        && isValidEpochMs(data.updatedAt)
        && data.rewardTotalExp is int
        && data.rewardTotalExp >= 0 && data.rewardTotalExp <= 100000000
        && data.rewardPoints is int
        && data.rewardPoints >= 0 && data.rewardPoints <= 100000000
        && data.rewardTotalMissions is int
        && data.rewardTotalMissions >= 0 && data.rewardTotalMissions <= 1000000
        && data.equippedSlotsJson is string && data.equippedSlotsJson.size() <= 2048
        && data.stampedDatesJson is string && data.stampedDatesJson.size() <= 4096
        && data.selectedCharacterId is string && data.selectedCharacterId.size() <= 64
        && data.darkMode is bool
        && data.coachingInterventionType is string && data.coachingInterventionType.size() <= 40
        && data.coachingIntensity is string && data.coachingIntensity.size() <= 40
        && data.characterIntensity is string && data.characterIntensity.size() <= 40
        && data.coachingTone is string && data.coachingTone.size() <= 40
        && data.bedtimeCareEnabled is bool
        && isValidOptionalInt(data.customBedtimeHour, 0, 23)
        && isValidOptionalInt(data.customBedtimeMinute, 0, 59)
        && data.goalsJson is string && data.goalsJson.size() <= 16384
        && data.sleepConfirmationsJson is string && data.sleepConfirmationsJson.size() <= 65536
        && isValidOptionalString(data.bedtimeMemoContent, 2000)
        && (data.bedtimeMemoSavedAt == null || (data.bedtimeMemoSavedAt is int && data.bedtimeMemoSavedAt >= 0 && data.bedtimeMemoSavedAt <= 4102444800000))
        && data.bedtimeMemoPending is bool;
    }

    function isValidMonthlyArchive(yearMonth, data) {
      return isValidYearMonthId(yearMonth)
        && data.keys().hasOnly([
          'yearMonth',
          'schemaVersion',
          'updatedAt',
          'activeDays',
          'totalPhoneMs',
          'shortformTotalMs',
          'dailyRecordsJson'
        ])
        && data.keys().hasAll([
          'yearMonth',
          'schemaVersion',
          'updatedAt',
          'activeDays',
          'totalPhoneMs',
          'shortformTotalMs',
          'dailyRecordsJson'
        ])
        && data.yearMonth == yearMonth
        && data.schemaVersion is int
        && data.schemaVersion >= 1 && data.schemaVersion <= 10
        && isValidEpochMs(data.updatedAt)
        && data.activeDays is int && data.activeDays >= 0 && data.activeDays <= 31
        && data.totalPhoneMs is int && data.totalPhoneMs >= 0 && data.totalPhoneMs <= 2678400000
        && data.shortformTotalMs is int && data.shortformTotalMs >= 0 && data.shortformTotalMs <= 2678400000
        && data.dailyRecordsJson is string && data.dailyRecordsJson.size() <= 400000;
    }

    function isValidShortformSessions(yearMonth, data) {
      return isValidYearMonthId(yearMonth)
        && data.keys().hasOnly([
          'yearMonth',
          'schemaVersion',
          'updatedAt',
          'sessionCount',
          'sessionsJson'
        ])
        && data.keys().hasAll([
          'yearMonth',
          'schemaVersion',
          'updatedAt',
          'sessionCount',
          'sessionsJson'
        ])
        && data.yearMonth == yearMonth
        && data.schemaVersion is int
        && data.schemaVersion >= 1 && data.schemaVersion <= 10
        && isValidEpochMs(data.updatedAt)
        && data.sessionCount is int && data.sessionCount >= 0 && data.sessionCount <= 1500
        && data.sessionsJson is string && data.sessionsJson.size() <= 400000;
    }

    function isValidShortformDaily(yearMonth, data) {
      return isValidYearMonthId(yearMonth)
        && data.keys().hasOnly([
          'yearMonth',
          'schemaVersion',
          'updatedAt',
          'recordCount',
          'recordsJson'
        ])
        && data.keys().hasAll([
          'yearMonth',
          'schemaVersion',
          'updatedAt',
          'recordCount',
          'recordsJson'
        ])
        && data.yearMonth == yearMonth
        && data.schemaVersion is int
        && data.schemaVersion >= 1 && data.schemaVersion <= 10
        && isValidEpochMs(data.updatedAt)
        && data.recordCount is int && data.recordCount >= 0 && data.recordCount <= 500
        && data.recordsJson is string && data.recordsJson.size() <= 200000;
    }

    // -------------------------------------------------------------------------
    // User Data Tree (Strict per-user isolation, no cross-user access)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Allow get only (never list all users)
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserRoot(request.resource.data);
      allow update: if isOwner(userId)
        && isValidUserRoot(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.provider == resource.data.provider;
      allow delete: if isOwner(userId);

      match /profile/{profileId} {
        allow read: if isOwner(userId) && profileId == 'state';
        allow create: if isOwner(userId)
          && profileId == 'state'
          && isValidProfileState(request.resource.data);
        allow update: if isOwner(userId)
          && profileId == 'state'
          && isValidProfileState(request.resource.data);
        allow delete: if isOwner(userId) && profileId == 'state';
      }

      match /monthly_archives/{yearMonth} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidMonthlyArchive(yearMonth, request.resource.data);
        allow update: if isOwner(userId)
          && isValidMonthlyArchive(yearMonth, request.resource.data)
          && request.resource.data.yearMonth == resource.data.yearMonth;
        allow delete: if isOwner(userId);
      }

      match /shortform_sessions/{yearMonth} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidShortformSessions(yearMonth, request.resource.data);
        allow update: if isOwner(userId)
          && isValidShortformSessions(yearMonth, request.resource.data)
          && request.resource.data.yearMonth == resource.data.yearMonth;
        allow delete: if isOwner(userId);
      }

      match /shortform_daily/{yearMonth} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidShortformDaily(yearMonth, request.resource.data);
        allow update: if isOwner(userId)
          && isValidShortformDaily(yearMonth, request.resource.data)
          && request.resource.data.yearMonth == resource.data.yearMonth;
        allow delete: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Customer Center Validators
    // -------------------------------------------------------------------------
    function isValidSupportDiagnostics(diag) {
      return diag == null || (
        diag is map
        && diag.keys().hasOnly([
          'appVersion',
          'androidVersion',
          'deviceModel',
          'usageGranted',
          'overlayGranted',
          'accessibilityConnected',
          'notificationsEnabled'
        ])
        && diag.keys().hasAll([
          'appVersion',
          'androidVersion',
          'deviceModel',
          'usageGranted',
          'overlayGranted',
          'accessibilityConnected',
          'notificationsEnabled'
        ])
        && diag.appVersion is string && diag.appVersion.size() >= 1 && diag.appVersion.size() <= 32
        && diag.androidVersion is string && diag.androidVersion.size() >= 1 && diag.androidVersion.size() <= 64
        && diag.deviceModel is string && diag.deviceModel.size() >= 1 && diag.deviceModel.size() <= 80
        && diag.usageGranted is bool
        && diag.overlayGranted is bool
        && diag.accessibilityConnected is bool
        && diag.notificationsEnabled is bool
      );
    }

    function isValidSupportInquiry(data) {
      return data.keys().hasOnly([
          'uid',
          'authorProvider',
          'authorLabel',
          'category',
          'title',
          'content',
          'diagnostics',
          'status',
          'adminReply',
          'adminUid',
          'createdAt',
          'repliedAt',
          'updatedAt',
          'isReplyRead'
        ])
        && data.keys().hasAll([
          'uid',
          'authorProvider',
          'authorLabel',
          'category',
          'title',
          'content',
          'diagnostics',
          'status',
          'adminReply',
          'adminUid',
          'createdAt',
          'repliedAt',
          'updatedAt',
          'isReplyRead'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.authorProvider is string && data.authorProvider in ['GOOGLE', 'KAKAO', 'NAVER', 'GUEST']
        && data.authorLabel is string && data.authorLabel.size() >= 1 && data.authorLabel.size() <= 60
        && data.category is string && data.category in ['BUG', 'SUGGESTION', 'USAGE_PERMISSION', 'ACCOUNT_DATA', 'OTHER']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.content is string && data.content.size() >= 5 && data.content.size() <= 1000
        && isValidSupportDiagnostics(data.diagnostics)
        && data.status is string && data.status in ['RECEIVED', 'ANSWERED']
        && (
          (data.status == 'RECEIVED'
            && data.adminReply == null
            && data.adminUid == null
            && data.repliedAt == null)
          ||
          (data.status == 'ANSWERED'
            && data.adminReply is string && data.adminReply.size() >= 1 && data.adminReply.size() <= 2000
            && data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128
            && isValidEpochMs(data.repliedAt))
        )
        && isValidEpochMs(data.createdAt)
        && isValidEpochMs(data.updatedAt)
        && data.updatedAt >= data.createdAt
        && data.isReplyRead is bool;
    }

    function supportInquiryUserFieldsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.authorProvider == resource.data.authorProvider
        && request.resource.data.authorLabel == resource.data.authorLabel
        && request.resource.data.category == resource.data.category
        && request.resource.data.title == resource.data.title
        && request.resource.data.content == resource.data.content
        && request.resource.data.diagnostics == resource.data.diagnostics
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // -------------------------------------------------------------------------
    // Customer Center Admin Allowlist (Firebase Console / Admin SDK only)
    // -------------------------------------------------------------------------
    match /support_admins/{adminUid} {
      allow get: if isOwner(adminUid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Customer Center 1:1 Inquiries
    // -------------------------------------------------------------------------
    match /support_inquiries/{inquiryId} {
      allow read: if isSupportAdmin()
        || (isAuthenticated() && resource.data.uid == request.auth.uid);

      allow create: if isAuthenticated()
        && isValidInquiryId(inquiryId)
        && request.resource.data.uid == request.auth.uid
        && (
          (request.auth.token.firebase.sign_in_provider == 'anonymous' && request.resource.data.authorProvider == 'GUEST')
          ||
          (request.auth.token.firebase.sign_in_provider != 'anonymous' && request.resource.data.authorProvider in ['GOOGLE', 'KAKAO', 'NAVER', 'GUEST'])
        )
        && request.resource.data.status == 'RECEIVED'
        && request.resource.data.adminReply == null
        && request.resource.data.adminUid == null
        && request.resource.data.repliedAt == null
        && request.resource.data.isReplyRead == true
        && isValidSupportInquiry(request.resource.data);

      allow update: if isValidSupportInquiry(request.resource.data)
        && supportInquiryUserFieldsUnchanged()
        && (
          (
            isAuthenticated()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'ANSWERED'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReplyRead', 'updatedAt'])
            && request.resource.data.isReplyRead == true
            && request.resource.data.updatedAt >= resource.data.updatedAt
          )
          ||
          (
            isSupportAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'adminReply',
              'adminUid',
              'repliedAt',
              'updatedAt',
              'isReplyRead'
            ])
            && request.resource.data.status == 'ANSWERED'
            && request.resource.data.adminUid == request.auth.uid
            && request.resource.data.isReplyRead == false
            && request.resource.data.updatedAt >= resource.data.updatedAt
          )
        );

      allow delete: if isSupportAdmin()
        || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }
  }
}
